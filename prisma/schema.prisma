  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  discount_menu_item discount_menu_item[]
  menu_category      menu_category?       @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  hotel              hotel                @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order_item         order_item[]

  @@index([hotel_id, is_available], map: "idx_menu_item_availability")
  @@index([category_id], map: "idx_menu_item_category_id")
  @@index([hotel_id], map: "idx_menu_item_hotel_id")
}

model notification {
  id         String   @id @db.Uuid
  hotel_id   String?  @db.Uuid
  user_id    String   @db.Uuid
  title      String   @db.VarChar(255)
  message    String
  type       String   @db.VarChar(30)
  event_key  String?  @db.VarChar(255)
  is_read    Boolean  @default(false)
  action_url String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  hotel      hotel?   @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hotel_id, user_id, event_key], map: "uq_notification_hotel_user_event")
  @@index([created_at], map: "idx_notification_created_at")
  @@index([hotel_id, user_id, created_at], map: "idx_notification_hotel_user_created")
  @@index([hotel_id, user_id, is_read], map: "idx_notification_hotel_user_unread")
  @@index([user_id, is_read], map: "idx_notification_unread")
  @@index([user_id], map: "idx_notification_user_id")
}

