/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model qr_code {
  id              String        @id @db.Uuid
  hotel_id        String        @db.Uuid
  code            String        @unique(map: "uq_qr_code") @db.VarChar(100)
  type            qr_code_type
  room_id         String?       @unique(map: "uq_qr_code_room", where: raw("(room_id IS NOT NULL)")) @db.Uuid
  dining_table_id String?       @unique(map: "uq_qr_code_dining_table", where: raw("(dining_table_id IS NOT NULL)")) @db.Uuid
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  dining_table    dining_table? @relation(fields: [dining_table_id, hotel_id], references: [id, hotel_id], onDelete: Cascade, onUpdate: NoAction)
  hotel           hotel         @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  room            room?         @relation(fields: [room_id, hotel_id], references: [id, hotel_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([dining_table_id, hotel_id], map: "uq_qr_code_dining_table_hotel_scope")
  @@unique([room_id, hotel_id], map: "uq_qr_code_room_hotel_scope")
  @@index([dining_table_id], map: "idx_qr_code_dining_table_id")
  @@index([hotel_id], map: "idx_qr_code_hotel_id")
  @@index([room_id], map: "idx_qr_code_room_id")
}

model role {
