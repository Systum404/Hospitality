model user_role {
  audit_event                      audit_event[]
  admin_invitation                 admin_invitation[]
  attendance                       attendance[]
  id                               String             @id @db.Uuid
  user_id                          String             @db.Uuid
  role_id                          Int
  role_scope                       role_scope         @default(HOTEL)
  status                           assignment_status  @default(ACTIVE)
  restore_on_identity_reactivation Boolean            @default(false)
  hotel_id                         String?            @db.Uuid
  hotel                            hotel?             @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role                             role               @relation(fields: [role_id, role_scope], references: [id, scope], onUpdate: NoAction)
  users                            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id], map: "uq_user_role_global", where: raw("(hotel_id IS NULL)"))
  @@unique([hotel_id, user_id, role_id], map: "uq_user_role_hotel", where: raw("(hotel_id IS NOT NULL)"))
  @@unique([id, hotel_id, user_id], map: "uq_user_role_attendance_scope")
  @@index([hotel_id], map: "idx_user_role_hotel_id")
  @@index([hotel_id, role_id, status], map: "idx_user_role_hotel_role_status")
  @@index([role_id], map: "idx_user_role_role_id")
  @@index([user_id], map: "idx_user_role_user_id")
}

model users {
  auth_context_challenges    auth_context_challenge[]
  password_change_challenge  password_change_challenge?
  audit_events_created       audit_event[]              @relation("AuditEventActor")
  admin_invitations_created  admin_invitation[]         @relation("AdminInvitationCreator")
  admin_invitations_received admin_invitation[]         @relation("AdminInvitationUser")
  attendance_records         attendance[]               @relation("AttendanceUser")
  attendance_recorded        attendance[]               @relation("AttendanceRecorder")
  recorded_payments          payment[]
  id                         String                     @id @db.Uuid
  email                      String                     @unique @db.VarChar(255)
  password_hash              String?                    @db.VarChar(255)
  name                       String                     @db.VarChar(255)
  phone                      String?                    @db.VarChar(20)
  is_active                  Boolean                    @default(true)
  credential_version         Int                        @default(0)
  password_change_required   Boolean                    @default(false)
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  last_login                 DateTime?                  @db.Timestamptz(6)
  notification               notification[]
  orders                     orders[]
  user_role                  user_role[]

  @@index([is_active], map: "idx_users_active")
  @@index([email], map: "idx_users_role_email")
}

model password_change_challenge {
  id                 String   @id @db.Uuid
  user_id            String   @unique @db.Uuid
  token_hash         String   @unique @db.Char(64)
  credential_version Int
  expires_at         DateTime @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  user               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_password_change_challenge_expires_at")
}

model auth_context_challenge {
  id                 String   @id @db.Uuid
  user_id            String   @db.Uuid
  token_hash         String   @unique @db.Char(64)
  remember           Boolean  @default(false)
  credential_version Int      @default(0)
  expires_at         DateTime @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  user               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_auth_context_challenge_user_id")
  @@index([expires_at], map: "idx_auth_context_challenge_expires_at")
}

model admin_invitation {
  id             String                  @id @db.Uuid
  hotel_id       String                  @db.Uuid
  user_id        String                  @db.Uuid
  user_role_id   String                  @db.Uuid
  email_snapshot String                  @db.VarChar(255)
  token_hash     String                  @unique(map: "uq_admin_invitation_token_hash") @db.Char(64)
  status         admin_invitation_status @default(PENDING)
  expires_at     DateTime                @db.Timestamptz(6)
  created_by     String                  @db.Uuid
  created_at     DateTime                @default(now()) @db.Timestamptz(6)
  accepted_at    DateTime?               @db.Timestamptz(6)
  revoked_at     DateTime?               @db.Timestamptz(6)
  superseded_at  DateTime?               @db.Timestamptz(6)
  hotel          hotel                   @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user           users                   @relation("AdminInvitationUser", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignment     user_role               @relation(fields: [user_role_id, hotel_id, user_id], references: [id, hotel_id, user_id], onDelete: Restrict, onUpdate: NoAction, map: "admin_invitation_user_role_scope_fkey")
  creator        users                   @relation("AdminInvitationCreator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([hotel_id, email_snapshot], map: "uq_admin_invitation_pending_identity", where: raw("(status = 'PENDING'::admin_invitation_status)"))
  @@index([hotel_id, created_at], map: "idx_admin_invitation_hotel_created")
  @@index([user_id], map: "idx_admin_invitation_user")
  @@index([user_role_id], map: "idx_admin_invitation_user_role")
  @@index([created_by], map: "idx_admin_invitation_created_by")
}

model audit_event {
  id                  String        @id @db.Uuid
  actor_user_id       String?       @db.Uuid
  actor_assignment_id String?       @db.Uuid
  actor_scope         role_scope?
  action              String        @db.VarChar(100)
  target_type         String        @db.VarChar(100)
  target_id           String?       @db.Uuid
  hotel_id            String?       @db.Uuid
  outcome             audit_outcome
  occurred_at         DateTime      @default(now()) @db.Timestamptz(6)
  request_id          String        @db.Uuid
  metadata            Json          @default("{}") @db.JsonB
  ip_address          String?       @db.Inet
  user_agent          String?       @db.VarChar(512)
  actor               users?        @relation("AuditEventActor", fields: [actor_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actor_assignment    user_role?    @relation(fields: [actor_assignment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  hotel               hotel?        @relation(fields: [hotel_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([occurred_at, id], map: "idx_audit_event_occurred")
  @@index([actor_user_id, occurred_at], map: "idx_audit_event_actor")
  @@index([hotel_id, occurred_at], map: "idx_audit_event_hotel")
  @@index([action, occurred_at], map: "idx_audit_event_action")
  @@index([target_type, target_id], map: "idx_audit_event_target")
  @@index([request_id], map: "idx_audit_event_request")
}

model attendance {
  id              String            @id @db.Uuid
  hotel_id        String            @db.Uuid
  user_id         String            @db.Uuid
  user_role_id    String            @db.Uuid
  attendance_date DateTime          @db.Date
  status          attendance_status
  recorded_at     DateTime          @default(now()) @db.Timestamptz(6)
  recorded_by     String?           @db.Uuid
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  hotel           hotel             @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user            users             @relation("AttendanceUser", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recorder        users?            @relation("AttendanceRecorder", fields: [recorded_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignment      user_role         @relation(fields: [user_role_id, hotel_id, user_id], references: [id, hotel_id, user_id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([hotel_id, user_id, attendance_date], map: "uq_attendance_hotel_user_date")
  @@index([hotel_id, attendance_date], map: "idx_attendance_hotel_date")
  @@index([user_id], map: "idx_attendance_user_id")
  @@index([recorded_by], map: "idx_attendance_recorded_by")
  @@index([user_role_id], map: "idx_attendance_user_role_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vendor {
  id             String      @id @db.Uuid
  hotel_id       String      @db.Uuid
  name           String      @db.VarChar(255)
  contact_person String?     @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  email          String?     @db.VarChar(255)
  address        String?
  items_supplied String?
  payment_terms  String?
  rating         Decimal     @default(0) @db.Decimal(3, 2)
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  inventory      inventory[]
  hotel          hotel       @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([hotel_id, is_active], map: "idx_vendor_active")
  @@index([hotel_id], map: "idx_vendor_hotel_id")
}

