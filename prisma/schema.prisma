generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model customer {
  id            String         @id @db.Uuid
  hotel_id      String         @db.Uuid
  first_name    String         @db.VarChar(255)
  last_name     String?        @db.VarChar(100)
  phone         String         @db.VarChar(20)
  email         String?        @db.VarChar(255)
  date_of_birth DateTime?      @db.Date
  address       String?
  city          String?        @db.VarChar(100)
  state         String?        @db.VarChar(100)
  country       String?        @db.VarChar(100)
  postal_code   String?        @db.VarChar(20)
  id_type       String?        @db.VarChar(50)
  id_number     String?        @db.VarChar(100)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  hotel         hotel          @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders        orders[]
  room_booking  room_booking[]

  @@unique([id, hotel_id], map: "uq_customer_hotel_scope")
  @@unique([hotel_id, phone], map: "uq_customer_hotel_phone")
  @@index([hotel_id, email], map: "idx_customer_email")
  @@index([hotel_id], map: "idx_customer_hotel_id")
  @@index([hotel_id, phone], map: "idx_customer_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dining_area {
  id           String         @id @db.Uuid
  hotel_id     String         @db.Uuid
  name         String         @db.VarChar(50)
  total_tables Int            @default(0)
  status       String         @db.VarChar(30)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  hotel        hotel          @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  dining_table dining_table[]

  @@unique([hotel_id, name], map: "uq_dining_area_name")
  @@unique([id, hotel_id], map: "uq_dining_area_hotel_scope")
  @@index([hotel_id], map: "idx_dining_area_hotel_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dining_table {
  id             String      @id @db.Uuid
  hotel_id       String      @db.Uuid
  dining_area_id String      @db.Uuid
  table_number   String      @db.VarChar(50)
  capacity       Int         @default(4)
  status         String      @db.VarChar(30)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  dining_area    dining_area @relation(fields: [dining_area_id, hotel_id], references: [id, hotel_id], onDelete: Cascade, onUpdate: NoAction)
  hotel          hotel       @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders         orders[]
  qr_code        qr_code?

  @@unique([hotel_id, dining_area_id, table_number], map: "uq_dining_table_area_number")
  @@unique([id, hotel_id], map: "uq_dining_table_hotel_scope")
  @@index([hotel_id], map: "idx_dining_table_hotel_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model discount {
  id                     String                   @id @db.Uuid
  hotel_id               String                   @db.Uuid
  name                   String                   @db.VarChar(255)
  description            String?
  discount_type          discount_type
  discount_value         Decimal                  @db.Decimal(10, 2)
  min_order_amount       Decimal                  @default(0) @db.Decimal(12, 2)
  max_discount_amount    Decimal?                 @db.Decimal(12, 2)
  applicable_on          String                   @db.VarChar(50)
  start_date             DateTime?                @db.Date
  end_date               DateTime?                @db.Date
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  hotel                  hotel                    @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  discount_menu_category discount_menu_category[]
  discount_menu_item     discount_menu_item[]

  @@index([hotel_id, is_active], map: "idx_discount_active")
  @@index([start_date, end_date], map: "idx_discount_dates")
  @@index([hotel_id], map: "idx_discount_hotel_id")
}

model discount_menu_category {
  discount_id   String        @db.Uuid
  category_id   String        @db.Uuid
  menu_category menu_category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discount      discount      @relation(fields: [discount_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([discount_id, category_id])
}

model discount_menu_item {
  discount_id  String    @db.Uuid
  menu_item_id String    @db.Uuid
  discount     discount  @relation(fields: [discount_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu_item    menu_item @relation(fields: [menu_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([discount_id, menu_item_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model hotel {
  audit_event             audit_event[]
  admin_invitation        admin_invitation[]
  attendance              attendance[]
  notification            notification[]
  bills                   bill[]
  billing_settings        hotel_billing_settings?
  id                      String             @id @db.Uuid
  code                    String             @unique(map: "uq_hotel_code") @default(dbgenerated("('HTL-'::text || lpad((nextval('hotel_code_sequence'::regclass))::text, 6, '0'::text))")) @db.VarChar(32)
  name                    String             @db.VarChar(255)
  type                    String?            @db.VarChar(50)
  latitude                Float?
  longitude               Float?
  address                 String?
  city                    String?            @db.VarChar(100)
  state_province          String?            @db.VarChar(100)
  country                 String?            @db.VarChar(100)
  postal_code             String?            @db.VarChar(20)
  phone                   String?            @db.VarChar(20)
  email                   String?            @db.VarChar(255)
  currency_code           String?            @db.Char(3)
  logo_url                String?            @db.VarChar(500)
  website                 String?            @db.VarChar(500)
  tax_registration_number String?            @db.VarChar(100)
  description             String?
  check_in_time           String?            @db.VarChar(5)
  check_out_time          String?            @db.VarChar(5)
  status                  hotel_status       @default(ACTIVE)
  plan                    hotel_plan         @default(UNASSIGNED)
  timezone                String             @default("Asia/Kolkata") @db.VarChar(100)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)
  customer                customer[]
  dining_area             dining_area[]
  dining_table            dining_table[]
  discount                discount[]
  inventory               inventory[]
  menu_category           menu_category[]
  menu_item               menu_item[]
  orders                  orders[]
  qr_code                 qr_code[]
  room                    room[]
  room_booking            room_booking[]
  tax_slab                tax_slab[]
  user_role               user_role[]
  vendor                  vendor[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  id               String    @id @db.Uuid
  hotel_id         String    @db.Uuid
  name             String    @db.VarChar(255)
  category         String?   @db.VarChar(100)
  quantity         Decimal   @default(0) @db.Decimal(12, 2)
  unit             String?   @db.VarChar(50)
  minimum_quantity Decimal   @default(0) @db.Decimal(12, 2)
  supplier_id      String?   @db.Uuid
  last_restocked   DateTime? @db.Date
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  hotel            hotel     @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendor           vendor?   @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)

  @@index([category], map: "idx_inventory_category")
  @@index([hotel_id], map: "idx_inventory_hotel_id")
  @@index([supplier_id], map: "idx_inventory_supplier")
}

model menu_category {
  id                     String                   @id @db.Uuid
  hotel_id               String                   @db.Uuid
  name                   String                   @db.VarChar(255)
  description            String?
  display_order          Int                      @default(0)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  discount_menu_category discount_menu_category[]
  hotel                  hotel                    @relation(fields: [hotel_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  menu_item              menu_item[]

  @@unique([hotel_id, name], map: "uq_menu_category_name")
  @@index([hotel_id], map: "idx_menu_category_hotel_id")
  @@index([hotel_id, display_order], map: "idx_menu_category_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_item {
  id                 String               @id @db.Uuid
  hotel_id           String               @db.Uuid
