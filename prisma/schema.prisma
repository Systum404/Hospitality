model bill {
  id                String        @id @db.Uuid
  hotel_id          String        @db.Uuid
  invoice_number    String        @unique @default(dbgenerated("('INV-'::text || to_char(nextval('bill_invoice_sequence'::regclass), 'FM000000000000'::text))")) @db.VarChar(50)
  type              String        @db.VarChar(20)
  room_booking_id   String?       @unique @db.Uuid
  order_id          String?       @unique @db.Uuid
  source_reference  String        @db.VarChar(50)
  hotel_snapshot    Json
  guest_snapshot    Json
  subtotal          Decimal       @db.Decimal(12, 2)
  taxable_subtotal  Decimal       @db.Decimal(12, 2)
  tax_amount        Decimal       @default(0) @db.Decimal(12, 2)
  discount_amount   Decimal       @default(0) @db.Decimal(12, 2)
  tax_snapshot      Json?
  discount_snapshot Json?
  service_charge_amount Decimal       @default(0) @db.Decimal(12, 2)
  service_charge_snapshot Json?
  total_amount      Decimal       @db.Decimal(12, 2)
  amount_paid       Decimal       @default(0) @db.Decimal(12, 2)
  balance_due       Decimal       @db.Decimal(12, 2)
  status            String        @default("DRAFT") @db.VarChar(30)
  created_by        String        @db.Uuid
  finalized_by      String?       @db.Uuid
  voided_by         String?       @db.Uuid
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  finalized_at      DateTime?     @db.Timestamptz(6)
  voided_at         DateTime?     @db.Timestamptz(6)
  hotel             hotel         @relation(fields: [hotel_id], references: [id], onDelete: Restrict)
  room_booking      room_booking? @relation(fields: [room_booking_id], references: [id], onDelete: Restrict)
  orders            orders?       @relation(fields: [order_id], references: [id], onDelete: Restrict)
  items             bill_item[]
  payments          payment[]

  @@unique([id, hotel_id])
  @@index([hotel_id, created_at])
}

model bill_item {
  id                String  @id @db.Uuid
  bill_id           String  @db.Uuid
  position          Int
  description       String
  source_order_id   String? @db.Uuid
  source_item_id    String? @db.Uuid
  menu_item_id      String? @db.Uuid
  menu_category_id  String? @db.Uuid
  discount_eligible Boolean @default(false)
  quantity          Int
  unit_price        Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)
  tax_amount        Decimal @default(0) @db.Decimal(12, 2)
  discount_amount   Decimal @default(0) @db.Decimal(12, 2)
  total_amount      Decimal @db.Decimal(12, 2)
  bill              bill    @relation(fields: [bill_id], references: [id], onDelete: Restrict)

  @@unique([bill_id, position])
}

model payment {
  id              String   @id @db.Uuid
  hotel_id        String   @db.Uuid
  bill_id         String   @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  method          String   @db.VarChar(10)
  status          String   @default("RECORDED") @db.VarChar(20)
  reference       String?  @db.VarChar(255)
  notes           String?
  idempotency_key String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  created_by      String   @db.Uuid
  bill            bill     @relation(fields: [bill_id, hotel_id], references: [id, hotel_id], onDelete: Restrict)
  users           users    @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@unique([hotel_id, idempotency_key])
  @@index([bill_id, created_at])
}
