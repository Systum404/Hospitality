  @@unique([hotel_id, idempotency_key], map: "uq_orders_public_idempotency")
  @@index([captain_id], map: "idx_orders_captain_id")
  @@index([hotel_id, created_at], map: "idx_orders_created_at")
  @@index([hotel_id], map: "idx_orders_hotel_id")
  @@index([room_booking_id], map: "idx_orders_room_booking_id")
  @@index([hotel_id, status], map: "idx_orders_status")
