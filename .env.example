# Use "production" only in the deployed backend environment.
NODE_ENV="development"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms"
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Optional comma-separated IP addresses/CIDR ranges of reverse proxies that
# directly connect to Express. Leave unset when Express is not behind a known
# proxy. Never use "true" or a blanket trust value.
TRUST_PROXY=""
PORT=4000

# Required in production. For stable local sessions, set a unique development
# value with at least 32 random characters in the uncommitted root .env file.
# Development omission intentionally uses an ephemeral process-local secret.
AUTH_SECRET=""

AUTH_ISSUER="aazira-hms"
AUTH_AUDIENCE="aazira-hms-web"
AUTH_TOKEN_TTL_SECONDS=1800
AUTH_REMEMBER_TTL_SECONDS=28800
AUTH_CONTEXT_CHALLENGE_TTL_SECONDS=300
PASSWORD_CHANGE_CHALLENGE_TTL_SECONDS=600

# Local provisioning only. Set every value in the uncommitted root .env before
# running `npm run provision:dev`. Never use these credentials in production.

# Dedicated development Super Admin bootstrap. These values are consumed only
# by `npm run bootstrap:super-admin`, which refuses production and non-local DBs.
DEV_SUPER_ADMIN_EMAIL="superadmin@local.aazira.test"
DEV_SUPER_ADMIN_PASSWORD="<set-a-local-development-password>"

# Frontend build setting (configure in the client build environment, not here):
# leave VITE_API_BASE_URL unset for the supported same-origin production topology.
